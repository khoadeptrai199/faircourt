# FairCourt local development values ONLY. Never reuse these outside local/demo.
# First run: cp .env.example .env   (the real .env is git-ignored)

POSTGRES_DB=faircourt
POSTGRES_USER=faircourt
POSTGRES_PASSWORD=faircourt_dev_only

# "local" enables the idempotent demo seed. Do not use outside local/demo.
SPRING_PROFILES_ACTIVE=local

# false on plain-HTTP localhost; true when served over HTTPS (blueprint section 0).
COOKIE_SECURE=false

# Demo login (local only).
DEMO_HOST_EMAIL=host@faircourt.local
DEMO_PASSWORD=FairCourtDemo!1
