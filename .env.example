# FairCourt local development values ONLY. Never reuse these outside local/demo.
# First run: cp .env.example .env   (the real .env is git-ignored)

POSTGRES_DB=faircourt
POSTGRES_USER=faircourt
POSTGRES_PASSWORD=faircourt_dev_only

# "local" enables the idempotent demo seed. Do not use outside local/demo.
SPRING_PROFILES_ACTIVE=local

# false on plain-HTTP localhost; true when served over HTTPS (blueprint section 0).
COOKIE_SECURE=false

# Demo login (local only).
DEMO_HOST_EMAIL=host@faircourt.local
DEMO_PASSWORD=FairCourtDemo!1

# Backend remote debugging for IntelliJ ("Remote JVM Debug", host port BACKEND_DEBUG_PORT below). Leave empty to turn off.
BACKEND_DEBUG_OPTS=-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=*:5005

# Frontend hot reload: set true only when the repo sits on a Windows drive under WSL (/mnt/c, /mnt/d).
VITE_USE_POLLING=false

# Host ports (what you open from the browser / IntelliJ). Kept in the 9090+ range so they never clash with
# the HRM project (8080, 8081, 1433, 6379, ...). Inside the containers the apps still use 8080 / 5173 / 5005.
BACKEND_PORT=9090
FRONTEND_PORT=9091
BACKEND_DEBUG_PORT=9092

# Host port for DBeaver / psql clients (PostgreSQL itself listens on 5432 inside the container).
POSTGRES_PORT=9093
