<?xml version="1.0" encoding="UTF-8"?>
<!-- Parent + aggregator for the FairCourt backend (F18, AD-13). Originally generated from start.spring.io
     (Spring Boot 4.1.2, Java 25) on 2026-11-09. Versions are pinned here once; modules inherit them. -->
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
	xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<groupId>org.springframework.boot</groupId>
		<artifactId>spring-boot-starter-parent</artifactId>
		<version>4.1.2</version>
		<relativePath/>
	</parent>
	<groupId>com.faircourt</groupId>
	<artifactId>faircourt-backend</artifactId>
	<version>0.0.1-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>faircourt-backend</name>

	<modules>
		<module>libs/common-web</module>
		<module>libs/matching</module>
		<module>services/gateway</module>
		<module>services/auth-service</module>
		<module>services/player-service</module>
		<module>services/playmatch-service</module>
	</modules>

	<properties>
		<java.version>25</java.version>
	</properties>

	<dependencyManagement>
		<dependencies>
			<dependency>
				<groupId>com.faircourt</groupId>
				<artifactId>common-web</artifactId>
				<version>${project.version}</version>
			</dependency>
			<dependency>
				<groupId>com.faircourt</groupId>
				<artifactId>matching</artifactId>
				<version>${project.version}</version>
			</dependency>
		</dependencies>
	</dependencyManagement>

	<build>
		<pluginManagement>
			<plugins>
				<!-- Formatting (owner decision 2026-11-09): Palantir Java Format via Spotless.
				     `spotless:check` runs in `mvn verify`; to fix formatting run the compose service "backend-format" (see README). -->
				<plugin>
					<groupId>com.diffplug.spotless</groupId>
					<artifactId>spotless-maven-plugin</artifactId>
					<version>3.11.0</version>
					<configuration>
						<java>
							<palantirJavaFormat>
								<version>2.103.0</version>
							</palantirJavaFormat>
						</java>
					</configuration>
					<executions>
						<execution>
							<goals>
								<goal>check</goal>
							</goals>
						</execution>
					</executions>
				</plugin>
			</plugins>
		</pluginManagement>
		<plugins>
			<plugin>
				<groupId>com.diffplug.spotless</groupId>
				<artifactId>spotless-maven-plugin</artifactId>
			</plugin>
			<!-- Runs *IT.java PostgreSQL integration tests during `mvn verify` (version managed by the Boot parent). -->
			<plugin>
				<groupId>org.apache.maven.plugins</groupId>
				<artifactId>maven-failsafe-plugin</artifactId>
				<executions>
					<execution>
						<goals>
							<goal>integration-test</goal>
							<goal>verify</goal>
						</goals>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
